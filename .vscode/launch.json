{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register"],
      "program": "${workspaceFolder}/index.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "dev"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
